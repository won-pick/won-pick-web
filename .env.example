# 각 담당 PC의 실제 LAN IP로 바꾸세요. localhost는 이 프론트 PC를 가리킵니다.
VITE_MARKET_URL=http://<MARKET_PC_IP>:8082
VITE_TRADE_URL=http://<TRADE_PC_IP>:8083

# Vite 서버가 Chat 담당 PC로 요청을 전달합니다.
CHAT_SERVER_URL=http://<CHAT_PC_IP>:8080

# 다른 PC에서도 프론트에 접속하려면 0.0.0.0으로 설정하세요.
# Market/Trade의 CORS에는 브라우저에서 접속할 실제 프론트 Origin을 지정합니다.
FRONTEND_HOST=localhost
